# Holds real ProPresenter/OBS host + credentials once filled in via the
# GUI or by hand — config.example.json is the template to commit instead.
config.json

# Local intro/outro series (see gui.py's Series Manager tab) — real local
# file paths specific to one setup, auto-created empty on first run.
series.json

